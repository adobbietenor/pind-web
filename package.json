{
  "name": "pind-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pin'd: the Cloudflare Worker, the Expo app (app/), shared types and copy (packages/shared/) and the Supabase schema",
  "workspaces": [
    "app",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "24.13.5",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "wrangler": "4.134.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@cf-wasm/resvg": "0.4.0",
    "@supabase/supabase-js": "2.116.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p packages/shared",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "test:policies": "node --env-file=.dev.vars --test --test-concurrency=1 tests/policies/policies.test.ts",
    "test:unit": "node --test tests/unit/access.test.ts tests/unit/origin.test.ts tests/unit/csv-time.test.ts tests/unit/import.test.ts tests/unit/ai.test.ts tests/unit/public.test.ts",
    "seed:staging": "node --env-file=.dev.vars scripts/seed-staging.ts",
    "typecheck:app": "npm run typecheck --workspace app",
    "build:web": "npm run export:web --workspace app",
    "brand": "node scripts/build-brand.ts",
    "deploy": "npm run build:web && wrangler deploy"
  }
}
