# Copy to app/.env (gitignored). Public client keys only — nothing secret goes in
# the app bundle. EAS builds take the same names from EAS environment variables.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: each is off, with one console line saying so, until it is set.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
