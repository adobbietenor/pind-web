{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "staging"
      },
      "node": "24.21.0"
    },
    "internal": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging"
      },
      "node": "24.21.0"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "node": "24.21.0"
    }
  },
  "submit": {
    "internal": {},
    "production": {}
  }
}
