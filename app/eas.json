{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "internal": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "internal": {},
    "production": {}
  }
}
