{
  // Staging only. Deploy under this name and no other.
  // Routed to pind.social from M2.1 (and workers.dev until Access moves). Until
  // pind-prod exists (M4.3), pind.social serves pind-staging, with seed rows kept off
  // every public read in the database (docs/visibility.md V18).
  // PindScene.com is a separate worker and is never touched from this repo.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pind-web-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  // False since M2.1: the admin lives at pind.social/admin behind its own Access
  // application, and the workers.dev hostname is gone rather than merely unused.
  "workers_dev": false,
  "preview_urls": false,

  // M2.1: pind.social. Routes live here rather than in the dashboard, for the same
  // reason migrations do — config I cannot reproduce from this repo is a broken repo.
  // Alex adds the proxied DNS record for the zone; until it exists these routes
  // deploy but nothing resolves, which is harmless.
  //
  // PindScene.com is never touched from this repo (decisions Part 5, "Routes:
  // pind.social only"); Alex sets its redirect in the dashboard.
  //
  // Done in M2.1: Access was re-created for pind.social/admin*, ACCESS_AUD narrowed to
  // that application alone, and workers_dev turned off, so the workers.dev admin is
  // gone rather than merely unused (M2.1 acceptance).
  "routes": [
    { "pattern": "pind.social/*", "zone_name": "pind.social" },
    { "pattern": "www.pind.social/*", "zone_name": "pind.social" }
  ],

  // M1.3: the nightly Ticketmaster import. **Cloudflare cron triggers are always
  // interpreted in UTC** — there is no timezone setting and the dashboard shows them
  // in UTC too — so 08:00 here is 08:00 UTC, which is 4am in Toronto in summer (EDT)
  // and 3am in winter (EST). No daylight-saving logic on our side.
  //
  // M2.2 does not rely on that being true. The watchdog that notices a missed night
  // derives its threshold from the schedule rather than from a fixed hour, and the
  // Worker reports the cron expression and the real scheduled time it was fired with
  // (ScheduledController) into the database on every run — so if this line ever
  // changes, or if the above is ever wrong, the watchdog follows it instead of
  // raising a phantom alarm.
  // M2.3b adds the second: the community liveness check at 13:00 UTC (9am EDT), which
  // reads a few series' own pages and records whether they still say the gathering
  // happens. Its own schedule, its own run row and its own lock — src/index.ts picks
  // the job by the expression that fired, and src/community/run.ts holds the matching
  // constant.
  "triggers": { "crons": ["0 8 * * *", "0 13 * * *"] },

  // M2.2: Workers Logs, on and unsampled. Without it there is no invocation history
  // at all, which is why nobody could tell whether the cron fired on the two nights
  // the import silently did not run. It belongs here and not in the dashboard for the
  // same reason the routes do: config I cannot reproduce from this repo is a broken
  // repo. A nightly cron and a handful of visitors are nowhere near the sampling
  // threshold, so head_sampling_rate stays at 1 — a sampled log is worse than none
  // when the question is "did this one invocation happen".
  //
  // Logs answer that question only for someone who goes and looks; the pg_cron
  // watchdog is what reaches out. Both, deliberately.
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Not secrets. The hard daily AI spend cap, US dollars per Toronto calendar day;
  // AI spot suggestions stay off until M1.3b ("on" to enable).
  "vars": { "AI_DAILY_CAP_USD": "3", "AI_SPOT_SUGGESTIONS": "off" },

  // M2.1: the two Poppins faces the OG image is rasterised with are imported as
  // bytes, not base64 (src/public/ogpng.ts). Nothing else in the Worker loads a font.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"] }],

  // M2.0: the Expo web export (app/dist, built by `npm run build:web`) is served
  // from the same host. The Worker's own routes run first; every other path is
  // the app, with single-page-app fallback to index.html (spec §4). Deploy with
  // `npm run deploy`, which builds the web export first: never one without the
  // other.
  //
  // M2.1 adds the public layer. "/g/*" is listed although /g/<slug>/pin is an APP
  // route: the Worker takes the whole prefix and hands back what it does not own
  // through the ASSETS binding, which keeps one place deciding what is public.
  //
  // M2.3 adds "/community", W1's second tab. **A Worker route that is not listed here
  // never runs**: the assets binding answers first and the app's single-page fallback
  // returns its own index.html with a 200, so the new page looked like a working page
  // of the wrong app rather than like a 404. Found by fetching the deployed URL, not
  // by reading the code — which is the M2.1 rule about checking from a browser, one
  // layer down again.
  "assets": {
    "binding": "ASSETS",
    "directory": "./app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/community",
      "/health",
      "/admin",
      "/admin/*",
      "/about",
      "/robots.txt",
      "/favicon.svg",
      "/g/*",
      "/og/*",
      "/map/*",
      "/venue-map/*",
      "/.well-known/*"
    ]
  }

  // Secrets (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SESSION_SECRET, ACCESS_*,
  // ADMIN_EMAILS, TICKETMASTER_CONSUMER_KEY, ANTHROPIC_API_KEY) are never written
  // here. Locally they come from .dev.vars; deployed, from
  // `npx wrangler secret put NAME`. See README.
}
